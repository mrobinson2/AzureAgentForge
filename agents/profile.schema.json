{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AzureAgentForge agent profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "role", "description", "model_tier", "toolsets"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 10 },
    "model_tier": { "type": "string", "enum": ["frontier", "standard", "economy"] },
    "toolsets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "enum": ["terminal", "file", "browser"] }
    },
    "reports_to": { "type": ["string", "null"] },
    "daily_budget_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Per-agent cost ceiling in USD/day (a cap, not a spend forecast). Summed and projected to a 30-day month by scripts/roster-cost-gate.py against PLATFORM_MONTHLY_BUDGET_USD in docker-compose.yml. See docs/design/roster-cost-gate.md."
    }
  }
}
