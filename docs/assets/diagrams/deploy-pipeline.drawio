        <!-- ============================================================ -->
        <mxCell id="grp-faces" value="Two operator faces — both drive the SAME plan/apply core (installer.core.plan_has_destroy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#AEB9C4;dashed=0;verticalAlign=top;fontColor=#5B7A95;fontSize=11;fontStyle=1;align=left;spacingLeft=12;spacingTop=6;arcSize=4;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="100" y="116" width="600" height="156" as="geometry" />
