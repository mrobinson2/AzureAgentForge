        <mxCell id="face-gha-ico" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#0078D4;strokeColor=none;dashed=0;html=1;shape=mxgraph.azure2019.devops;" vertex="1" parent="1">
          <mxGeometry x="418" y="160" width="28" height="28" as="geometry" />
