        <!-- Forge Console face -->
        <mxCell id="face-forge" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="148" width="262" height="108" as="geometry" />
