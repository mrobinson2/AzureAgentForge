          <mxGeometry x="168" y="158" width="206" height="22" as="geometry" />
        </mxCell>
        <mxCell id="face-forge-d" value="Local GUI · 127.0.0.1:8321 · per-session token&#10;streams init → validate → plan → apply (SSE)&#10;typed env-name confirm on apply / destroy" style="text;html=1;align=left;verticalAlign=top;fontColor=#5B6B7B;fontSize=10;spacingLeft=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
