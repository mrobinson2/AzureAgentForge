        <mxCell id="e2-l" value="2  resolve tenant from subdomain" style="text;html=1;align=center;verticalAlign=middle;fontColor=#0B3D66;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#0B3D66;rounded=1;arcSize=40;spacing=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="232" y="424" width="180" height="18" as="geometry" />
        </mxCell>

        <!-- 3: PaperClip -> Hermes (dispatch, carries tenant) -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0B3D66;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="app-paperclip" target="app-hermes">
          <mxGeometry relative="1" as="geometry" />
