        <mxCell id="lg-flow-num" value="n" style="text;html=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=9;fontStyle=1;fillColor=#0B3D66;strokeColor=none;rounded=1;arcSize=50;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="468" y="1098" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg-flow-t" value="numbered tenant request data-flow" style="text;html=1;align=left;verticalAlign=middle;fontColor=#42505E;fontSize=10;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="506" y="1098" width="210" height="20" as="geometry" />
        </mxCell>

        <!-- control-plane / provisioning -->
        <mxCell id="lg-ctl-line" value="" style="endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#8E7CC3;strokeWidth=1.5;html=1;" edge="1" parent="1">
