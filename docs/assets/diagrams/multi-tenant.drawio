          <mxGeometry x="718" y="494" width="186" height="18" as="geometry" />
        </mxCell>

        <!-- 6: Honcho -> Postgres (SET app.tenant_id, RLS-filtered) -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#3C7A47;strokeWidth=2;exitX=1;exitY=0.85;entryX=0;entryY=0.4;" edge="1" parent="1" source="app-honcho" target="data-pg">
          <mxGeometry relative="1" as="geometry">
