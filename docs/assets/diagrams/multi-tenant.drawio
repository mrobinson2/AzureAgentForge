        <mxCell id="ec2-l" value="C2  provision tenant: tenant_id + RLS policies + KV secrets" style="text;html=1;align=center;verticalAlign=middle;fontColor=#6A4FA3;fontSize=9;fontStyle=2;fillColor=#FFFFFF;strokeColor=none;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1300" y="380" width="244" height="16" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- EDGES — DATA PLANE (numbered solid request flow)              -->
        <!-- ============================================================ -->

        <!-- 1: tenant A users -> wildcard tunnel -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0B3D66;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="tenant-a-user" target="cf-wild">
