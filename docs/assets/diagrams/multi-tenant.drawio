          <mxGeometry x="378" y="486" width="130" height="18" as="geometry" />
        </mxCell>

        <!-- 4: Hermes -> Router (X-Tenant-ID) -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0B3D66;strokeWidth=2;exitX=0.4;exitY=1;entryX=0.4;entryY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="app-hermes-d" target="app-router">
