        <!-- second legend row -->
        <mxCell id="lg-rls-ico" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#3C7A47;strokeColor=none;dashed=0;html=1;shape=mxgraph.azure2019.lock;" vertex="1" parent="1">
          <mxGeometry x="180" y="1124" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg-rls-t" value="lock = tenant-isolated by RLS / scoped secrets" style="text;html=1;align=left;verticalAlign=middle;fontColor=#42505E;fontSize=10;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="204" y="1124" width="280" height="18" as="geometry" />
        </mxCell>

        <mxCell id="lg-design-swatch" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E0;strokeColor=#C9A45B;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="506" y="1124" width="24" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg-design-t" value="dashed + muted = design target / scaffold (not built or not deployed)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#6B7886;fontSize=10;fontStyle=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="538" y="1124" width="450" height="18" as="geometry" />
        </mxCell>

        <!-- contrast note vs single-tenant -->
        <mxCell id="contrast-note" value="How the single-tenant stack becomes per-tenant:&#10;the same shared containers + one Postgres serve&#10;every tenant. Isolation is added in three planes —&#10;routing (subdomain → JWT → X-Tenant-ID),&#10;data (tenant_id column + RLS default-deny),&#10;secrets (platform-{slug}-* KV prefix) — instead of&#10;duplicating infrastructure per tenant.&#10;See docs/assets/diagrams/system-architecture.* for&#10;the shipped single-tenant baseline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFD;strokeColor=#C7D2DD;dashed=0;fontColor=#5B6B7B;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1246" y="1040" width="308" height="108" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
