        <mxCell id="e6-l" value="6  SET app.tenant_id · RLS-filtered queries" style="text;html=1;align=center;verticalAlign=middle;fontColor=#3C7A47;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#3C7A47;rounded=1;arcSize=40;spacing=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1182" y="640" width="120" height="30" as="geometry" />
        </mxCell>

        <!-- 7: Router -> Foundry (per-tenant budgeted inference) -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C9851F;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="app-router" target="llm-foundry">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
