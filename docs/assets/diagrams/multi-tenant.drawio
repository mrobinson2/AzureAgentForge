        <mxCell id="rls-t" value="Schema-per-tenant via RLS  (design target)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#2E6638;fontSize=12;fontStyle=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1280" y="560" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rls-d" value="• tenant_id UUID column on every table&#10;  (workspaces, peers, sessions, messages,&#10;  message_embeddings, documents,&#10;  collections, queue; paperclip ↔ company_id)&#10;• ROW LEVEL SECURITY enabled per table&#10;• policy: tenant_id = current_setting&#10;  ('app.tenant_id')::uuid  (USING + WITH CHECK)&#10;• app roles honcho_app / paperclip_app&#10;  subject to RLS — default DENY&#10;• postgres admin bypasses RLS (not used by apps)" style="text;html=1;align=left;verticalAlign=top;fontColor=#3C7A47;fontSize=9;spacingLeft=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1250" y="590" width="226" height="166" as="geometry" />
        </mxCell>

        <!-- Key Vault tenant-prefixed -->
        <mxCell id="data-kv" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5FA56B;strokeWidth=1.5;verticalAlign=top;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1238" y="776" width="246" height="92" as="geometry" />
        </mxCell>
        <mxCell id="data-kv-ico" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#3C7A47;strokeColor=none;dashed=0;html=1;shape=mxgraph.azure2019.key_vaults;" vertex="1" parent="1">
          <mxGeometry x="1250" y="788" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="data-kv-t" value="Key Vault (shared)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1B2733;fontSize=12;fontStyle=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1288" y="786" width="190" height="34" as="geometry" />
        </mxCell>
        <mxCell id="data-kv-d" value="tenant-prefixed secrets platform-{slug}-*&#10;+ platform-shared-* · RBAC condition scopes&#10;each tenant identity to its own prefix" style="text;html=1;align=left;verticalAlign=top;fontColor=#5B6B7B;fontSize=10;spacingLeft=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1250" y="826" width="224" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lock-kv" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#3C7A47;strokeColor=none;dashed=0;html=1;shape=mxgraph.azure2019.lock;" vertex="1" parent="1">
          <mxGeometry x="1456" y="784" width="18" height="18" as="geometry" />
        </mxCell>

        <!-- Audit log + AI Search note -->
        <mxCell id="data-audit" value="Audit log (design target): audit_log table + per-table triggers capture every tenant-scoped INSERT / UPDATE / DELETE. Per-tenant Azure AI Search index mem-{slug} created at onboarding." style="text;html=1;align=left;verticalAlign=top;fontColor=#3C7A47;fontSize=9;fontStyle=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1238" y="884" width="250" height="120" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- EDGES — CONTROL PLANE (provisioning, purple dashed)           -->
        <!-- ============================================================ -->

        <!-- provisioning API -> registry -->
        <mxCell id="ec1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8E7CC3;strokeWidth=1.5;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ctl-api" target="ctl-reg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec1-l" value="C1  create / read tenant" style="text;html=1;align=center;verticalAlign=middle;fontColor=#6A4FA3;fontSize=9;fontStyle=1;fillColor=#F2EEF8;strokeColor=#8E7CC3;rounded=1;arcSize=40;spacing=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1124" y="170" width="120" height="16" as="geometry" />
        </mxCell>

        <!-- control registry -> RLS data plane (provision: tenant_id, RLS, secrets) -->
        <mxCell id="ec2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8E7CC3;strokeWidth=1.5;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="ctl-reg" target="rls">
