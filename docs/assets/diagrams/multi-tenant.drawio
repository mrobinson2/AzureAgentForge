          </mxGeometry>
        </mxCell>
        <mxCell id="e7-l" value="7  inference (per-tenant budget)" style="text;html=1;align=center;verticalAlign=middle;fontColor=#C9851F;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#C9851F;rounded=1;arcSize=40;spacing=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="810" y="290" width="180" height="18" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- LLM BACKEND (shared)                                          -->
        <!-- ============================================================ -->
        <mxCell id="llm-foundry" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9A45B;dashed=0;strokeWidth=1.5;verticalAlign=top;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="262" width="280" height="74" as="geometry" />
        </mxCell>
        <mxCell id="llm-foundry-ico" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#C9A45B;strokeColor=none;dashed=0;html=1;shape=mxgraph.azure2019.cognitive_services;" vertex="1" parent="1">
          <mxGeometry x="1022" y="274" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="llm-foundry-t" value="Azure AI Foundry  (shared backend)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1B2733;fontSize=12;fontStyle=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1060" y="272" width="226" height="22" as="geometry" />
        </mxCell>
        <mxCell id="llm-foundry-d" value="primary inference · stateless per request&#10;no cross-tenant state in the router or model" style="text;html=1;align=left;verticalAlign=top;fontColor=#8A6D1F;fontSize=10;spacingLeft=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1022" y="304" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- LEGEND                                                        -->
        <!-- ============================================================ -->
        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AEB9C4;dashed=0;arcSize=4;" vertex="1" parent="1">
