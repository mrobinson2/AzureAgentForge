        <mxCell id="lg-ctl-t" value="control plane · tenant provisioning (Cn)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#42505E;fontSize=10;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="774" y="1098" width="240" height="20" as="geometry" />
