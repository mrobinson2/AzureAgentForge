          <mxGeometry x="278" y="188" width="20" height="20" as="geometry" />
        </mxCell>
        <!-- 1: tenant B users -> wildcard tunnel (same front door) -->
        <mxCell id="e1b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0B3D66;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="tenant-b-user" target="cf-wild">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1b-l" value="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fillColor=#0B3D66;strokeColor=none;rounded=1;arcSize=50;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="278" y="232" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- 2: wildcard tunnel -> PaperClip (resolve tenant) -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0B3D66;strokeWidth=2;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cf-wild" target="app-paperclip">
