          <mxGeometry x="556" y="556" width="174" height="18" as="geometry" />
        </mxCell>

        <!-- 5: Hermes <-> Honcho (tenant-scoped memory) -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#2E6CA3;strokeWidth=2;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="app-hermes" target="app-honcho">
