        <mxCell id="m4-n" value="4" style="text;html=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fillColor=#2E6CA3;strokeColor=none;rounded=1;arcSize=50;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="648" y="420" width="20" height="20" as="geometry" />
