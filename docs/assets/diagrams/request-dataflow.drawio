        <mxCell id="gov-admit-d" value="write-time choke point:&#10;classify → validate scope → check&#10;writer authority → dedupe →&#10;retention decision → persist to&#10;Honcho documents (sync_state=pending)" style="text;html=1;align=left;verticalAlign=top;fontColor=#6B7886;fontSize=9;spacingLeft=2;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
