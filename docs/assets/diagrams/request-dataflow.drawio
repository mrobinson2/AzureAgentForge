        <mxCell id="m6-l" value="inference (primary tier deployment)" style="text;html=1;align=center;verticalAlign=bottom;fontColor=#C9851F;fontSize=10;fontStyle=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="925" y="710" width="300" height="16" as="geometry" />
        </mxCell>
        <!-- 6b: fallback chain (dotted gold, loops on router lane) -->
        <mxCell id="m6b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=4 4;strokeColor=#C9851F;strokeWidth=1.5;" edge="1" parent="1">
