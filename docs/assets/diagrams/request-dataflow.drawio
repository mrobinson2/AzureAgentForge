        <mxCell id="m4-l" value="read prior context + write new facts (memory r/w)" style="text;html=1;align=center;verticalAlign=bottom;fontColor=#2E6CA3;fontSize=10;fontStyle=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
