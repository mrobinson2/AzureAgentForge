        <mxCell id="gov-band-lbl" value="Memory Governor (optional · memory_governor_enabled, off by default)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#6B7886;fontSize=10;fontStyle=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
