# Self-hosted PRIMARY site — environment template.
#
# DO NOT commit a filled-in copy. The real .env is generated by secrets-pull.sh
# (which reads Key Vault) plus a few operator-set values below. Keep .env at
# chmod 600 on a full-disk-encrypted volume — it holds platform secrets at rest
# on a machine you own.
#
# Three sources of values:
#   [pull]   written by secrets-pull.sh from Key Vault (do not hand-edit)
#   [you]    operator sets once (DB host, paths, image tags)
#   [fixed]  structural overrides vs the cloud deployment

# ── paths & registry [you / fixed] ─────────────────────────────────────────
AAF_HOME=/Users/<you>/aaf
ACR_LOGIN_SERVER=your-registry.azurecr.io
# Image tags: pin to the registry build numbers you pulled. Bump in lockstep
# with what the cloud standby runs so the two sites match.
HONCHO_IMAGE_TAG=latest
ROUTER_IMAGE_TAG=latest
PAPERCLIP_IMAGE_TAG=latest
MEMORY_GOVERNOR_IMAGE_TAG=latest

# ── shared managed PostgreSQL (the database NEVER moves) [you / pull] ───────
# BOTH sites talk to the same managed PostgreSQL Flexible Server over its PUBLIC
# endpoint with sslmode=require. There is no local postgres; failover is a
# stateless compute switch. AZURE_PG_HOST is plain config [you]; the password is
# pulled from Key Vault by secrets-pull.sh [pull] — do not hand-edit it.
AZURE_PG_HOST=your-pg.postgres.database.azure.com
POSTGRES_USER=dbadmin
POSTGRES_PASSWORD=
# Percent-encoded twin of POSTGRES_PASSWORD, derived by secrets-pull.sh. The DB
# URLs in docker-compose.yml use this because libpq / SQLAlchemy URI parsing
# rejects raw special characters in the userinfo component.
POSTGRES_PASSWORD_URLENC=

# ── Cloudflare tunnel connector [pull] ─────────────────────────────────────
# Token for this host's connector of the shared tunnel (one tunnel, two
# connectors). Pulled from Key Vault by secrets-pull.sh.
CLOUDFLARE_TUNNEL_TOKEN=

# ── secrets pulled from Key Vault [pull] ───────────────────────────────────
# secrets-pull.sh writes the lines below. Names mirror the cloud container env.
PAPERCLIP_AGENT_JWT_SECRET=
PAPERCLIP_AUTOMATION_JWT_SECRET=
PAPERCLIP_AUTOMATION_JWT_ISSUER=automation
PAPERCLIP_AUTOMATION_JWT_AUDIENCE=paperclip-api
PAPERCLIP_ADMIN_EMAIL=
PAPERCLIP_ADMIN_PASSWORD=
BETTER_AUTH_SECRET=
GOVERNOR_API_KEY=
GOVERNOR_WORKSPACE=
# Canonical user peer (A5) [fixed] — ONE deploy-time id for the human
# principal's memory peer; compose threads it into the governor (its /admit
# `observed` default) and paperclip (the pc-memory/pc-honcho helpers). Leave
# empty to take the platform-wide "user" default; if this site's memory was
# built under a different peer id, set it here ONCE — never per service.
# docs/design/memory-system.md §18.
HONCHO_USER_PEER_ID=
# aaf-0005: model-router fails closed without this; paperclip's OPENAI_API_KEY
# (docker-compose.yml) reuses the same value as its bearer to the router.
ROUTER_API_KEY=
# Router tiers (primary + budget fallback)
GPT4O_API_KEY=
EMBEDDING_API_KEY=
PHI_BASE_URL=
PHI_API_KEY=

# ── structural overrides [fixed] (also set per-service in compose) ──────────
NODE_ENV=production
LOG_LEVEL=info
# OPENAI_API_KEY is the in-pod router marker, not a real key.
OPENAI_API_KEY=router-internal
PAPERCLIP_ALLOWED_HOSTNAMES=app.example.com,localhost
PAPERCLIP_PUBLIC_URL=https://app.example.com
PAPERCLIP_API_URL=http://127.0.0.1:3099/api
