<?xml version="1.0" encoding="UTF-8"?>
<!-- Hourly warm-standby share sync (Windows PRIMARY site, WSL2 variant).
     Windows equivalent of com.azureagentforge.sync.plist. Fires at Windows
     startup AND every hour, invoking the SHARED sync/sync.sh in WSL: azcopy the
     two file shares local -> cloud and stamp a freshness event. The bash script
     no-ops when the lease mirror does not name this site. The database is SHARED
     and never synced. Placeholders substituted by Install-WindowsSite.ps1. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <URI>\AzureAgentForge\AAF-ShareSync</URI>
    <Description>Warm-standby share sync — runs deploy/mac-site/sync/sync.sh in WSL hourly (mirrors launchd com.azureagentforge.sync, StartInterval 3600).</Description>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
      <Repetition>
        <Interval>PT1H</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>wsl.exe</Command>
      <Arguments>-d {{WSL_DISTRO}} -u {{WSL_USER}} -e bash -lc &quot;{{REPO}}/deploy/mac-site/sync/sync.sh&quot;</Arguments>
    </Exec>
  </Actions>
</Task>
